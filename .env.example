# Variáveis de ambiente do servidor do ERASÓ.
# Copie para .env se quiser (o servidor lê direto do ambiente; defina-as no painel da hospedagem).
# NUNCA coloque valores reais neste arquivo nem faça commit de um .env.

# Porta HTTP (hospedagens costumam definir sozinhas)
PORT=8780

# Modo público: 1 = aceita a internet, exige código de sala e ativa limites. Vazio = só rede local.
ERASO_PUBLICO=

# Confiar no cabeçalho X-Forwarded-For para identificar o IP do cliente (1/0).
# Padrão: ligado no modo público (hospedagens ficam atrás de um proxy), desligado no local.
ERASO_PROXY=

# Servidores STUN (lista separada por vírgulas). Padrão no modo público: stun:stun.cloudflare.com:3478
ERASO_STUN=

# Servidor TURN (opcional, retransmite quando a conexão direta não fecha).
# As credenciais são entregues aos navegadores por /api/config: use credenciais próprias para o ERASÓ,
# com limite de uso, e nunca as de uma conta pessoal.
ERASO_TURN_URL=
ERASO_TURN_USER=
ERASO_TURN_CRED=
